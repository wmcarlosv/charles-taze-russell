# Cambia biblioteca.example.com por tu dominio real.
biblioteca.example.com {
    encode gzip zstd

    # Crea el hash con:  caddy hash-password
    basicauth {
        carlos $2a$14$REEMPLAZA_ESTO_POR_TU_HASH
    }

    reverse_proxy 127.0.0.1:8100

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    request_body {
        max_size 1MB
    }
}
