[Unit]
Description=Pastor Russell Library
After=network.target

[Service]
Type=simple
User=carlos
WorkingDirectory=/opt/pastor-russell-library
Environment=HOST=127.0.0.1
Environment=PUERTO=8100
ExecStart=/usr/bin/python3 asistente.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
